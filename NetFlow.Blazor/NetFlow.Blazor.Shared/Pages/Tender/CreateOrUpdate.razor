@page "/tender/createorupdate/{Id:int?}"
@inject NavigationManager NavigationManager
@inject IApiClientFactory ApiClientFactory
@inject IHttpClientFactory HttpClientFactory
@inject IToastNotificationService ToastService

<div class="content-root">
    <div class="card toolbar">
        <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
            <Items>
                <DxToolbarItem IconCssClass="back-icon icon medium-icon" Tooltip="Geri Dön" Click="@NavigateBack" />
                <DxToolbarItem>
                    <Template>
                        <div class="custom-item">
                            <div class="title">@(Id > 0 ? "Ýhale Düzenleme" : "Yeni Ýhale Tanýmlama")</div>
                        </div>
                    </Template>
                </DxToolbarItem>
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right">
                    <Template>
                        <DxButton Text="Kaydet"
                                  Click="SaveFromOutside"
                                  Enabled="@(!IsSaving)"
                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                  RenderStyle="ButtonRenderStyle.Success" />
                    </Template>
                </DxToolbarItem>
            </Items>
        </DxToolbar>
    </div>

    <div class="tender-edit">
        <DxLoadingPanel Visible="@(EditContext == null)" IsContentBlocked="true" IsContentVisible="false" IndicatorVisible="true" IndicatorAreaVisible="true" ZIndex="101" Text="Yükleniyor...">
            @if (EditContext != null && Model != null)
            {
                <DxGridLayout ColumnSpacing="1rem" RowSpacing="1rem" CssClass="h-100">
                    <Columns>
                        <DxGridLayoutColumn Width="100%" />
                    </Columns>
                    <Rows>
                        <DxGridLayoutRow Areas="Item1" />
                    </Rows>
                    <Items>
                        <DxGridLayoutItem Area="item1">
                            <Template>
                                <EditForm EditContext="@EditContext" Context="formContext">
                                    <DataAnnotationsValidator />

                                    <DxFormLayout>
                                        <DxFormLayoutItem Caption="Firma" ColSpanMd="12">
                                            <DxComboBox TData="FirmModel"
                                                        TValue="int"
                                                        Data="@Firms"
                                                        TextFieldName="@nameof(FirmModel.FirmName)"
                                                        ValueFieldName="@nameof(FirmModel.Id)"
                                                        @bind-Value="@Model.FirmId"
                                                        FilteringMode="DataGridFilteringMode.Contains"
                                                        NullText="Firma seçiniz veya arayýn..."
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto">
                                            </DxComboBox>
                                        </DxFormLayoutItem>


                                        <DxFormLayoutItem Caption="Ýhale Kodu" ColSpanMd="6">
                                            <DxTextBox @bind-Text="Model.TenderCode" BindValueMode="BindValueMode.OnInput" />
                                        </DxFormLayoutItem>
                                        <DxFormLayoutItem Caption="Ýhale Adý" ColSpanMd="6">
                                            <DxTextBox @bind-Text="Model.TenderName" BindValueMode="BindValueMode.OnInput" />
                                        </DxFormLayoutItem>



                                        <!--Kamu idaresi / Kurum -->
                                        <DxFormLayoutItem Caption="Cari Kodu" ColSpanMd="6">
                                            <DxTextBox Text="@Model.PublicAuthorityCode"
                                                       TextChanged="@((string val) => OnCustomerCodeChanged(val))"
                                                       TextExpression="@(() => Model.PublicAuthorityCode)"
                                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                       BindValueMode="BindValueMode.OnInput">
                                                <Buttons>
                                                    <DxEditorButton IconCssClass="three-point-icon icon medium-icon"
                                                                    Tooltip="Hesap Kodu Seç"
                                                                    Click="OpenCustomerPopup" />
                                                </Buttons>
                                            </DxTextBox>
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Cari Adý" ColSpanMd="6">
                                            <DxTextBox Text="@Model.PublicAuthorityName"
                                                       TextChanged="@((val) => Model.PublicAuthorityName = val)"
                                                       TextExpression="@(() => Model.PublicAuthorityName)"
                                                       ReadOnly="true"
                                                       BindValueMode="BindValueMode.OnInput" />
                                        </DxFormLayoutItem>
                                        <!--Kamu idaresi / Kurum -->


                                        <DxFormLayoutItem Caption="Ýhale Türü" ColSpanMd="6">
                                            <DxComboBox Data="@IhaleTurleri"
                                                        @bind-Value="@SecilenTur"
                                                        FilteringMode="DataGridFilteringMode.Contains"
                                                        NullText="Tür arayýn veya seçin..."
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Ýhale Metodu" ColSpanMd="6">
                                            <DxComboBox Data="@IhaleMetotlari"
                                                        @bind-Value="@SecilenMetot"
                                                        FilteringMode="DataGridFilteringMode.Contains"
                                                        NullText="Metot arayýn veya seçin..."
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Ýhale Baþlangýç" ColSpanMd="6">
                                            <DxDateEdit @bind-Date="Model.TenderStartDate" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Ýhale Bitiþ" ColSpanMd="6">
                                            <DxDateEdit @bind-Date="Model.TenderEndDate"
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                        </DxFormLayoutItem>


                                        <DxFormLayoutItem Caption="Ýhale Miktarý" ColSpanMd="6">
                                            <DxSpinEdit @bind-Value="Model.TenderQuantity"
                                                        DisplayFormat="c2"
                                                        MinValue="0" />

                                        </DxFormLayoutItem>
                                        <DxFormLayoutItem Caption="Ýhale Toplam Tutarý" ColSpanMd="6">
                                            <DxSpinEdit @bind-Value="Model.TenderAmount"
                                                        DisplayFormat="c2"
                                                        MinValue="0" />

                                        </DxFormLayoutItem>
                                        <DxFormLayoutItem Caption="Birim Fiyat" ColSpanMd="6">
                                            <DxSpinEdit @bind-Value="Model.UnitPrice"
                                                        DisplayFormat="c2"
                                                        MinValue="0" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Para Birimi" ColSpanMd="6">
                                            <DxComboBox Data="@ParaBirimleri"
                                                        @bind-Value="@SecilenPara"
                                                        FilteringMode="DataGridFilteringMode.Contains"
                                                        NullText="Birim arayýn veya seçin..."
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                        </DxFormLayoutItem>


                                        <DxFormLayoutItem Caption="Geçici Teminat" ColSpanMd="6">
                                            <DxComboBox TData="GuaranteeModel"
                                                        TValue="int?"
                                                        Data="@TemporaryGuarantees"
                                                        TextFieldName="@nameof(GuaranteeModel.Subject)"
                                                        ValueFieldName="@nameof(GuaranteeModel.Id)"
                                                        @bind-Value="@Model.TemporaryGuaranteeRateId"
                                                        FilteringMode="DataGridFilteringMode.Contains"
                                                        NullText="Teminat seçiniz veya arayýn..."
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto">
                                            </DxComboBox>
                                        </DxFormLayoutItem>


                                        <DxFormLayoutItem Caption="Ýhale Ýlan Tarihi" ColSpanMd="6">
                                            <DxDateEdit @bind-Date="Model.AnnouncementDate" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Ýhale Ödeme Vadesi(Gün)" ColSpanMd="4">
                                            <DxSpinEdit @bind-Value="Model.TenderDueDate"
                                                        MinValue="0" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Sözleþme Davet Tarihi" ColSpanMd="4">
                                            <DxDateEdit @bind-Date="Model.ContractInvitationDate" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Sözleþme Tarihi" ColSpanMd="4">
                                            <DxDateEdit @bind-Date="Model.ContractDate" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem ColSpanMd="12">
                                            <ValidationSummary />
                                        </DxFormLayoutItem>

                                    </DxFormLayout>

                                </EditForm>
                            </Template>
                        </DxGridLayoutItem>

                    </Items>
                </DxGridLayout>
            }

        </DxLoadingPanel>
    </div>


    <div class="tender-detail-component-space ">
        <DxLayoutBreakpoint DeviceSize="DeviceSize.XSmall | DeviceSize.Small | DeviceSize.Medium" @bind-IsActive="@IsSmallScreen" />

        <DxGridLayout ColumnSpacing="1rem" RowSpacing="1rem" CssClass="h-100">
            <Columns>
                @if (!IsSmallScreen)
                {
                    <DxGridLayoutColumn Width="3fr" />
                }
                else
                {
                    <DxGridLayoutColumn Width="100%" />
                }
            </Columns>
            <Rows>
                @if (!IsSmallScreen)
                {
                    <DxGridLayoutRow Areas="item1" />
                }
                else
                {
                    <DxGridLayoutRow Areas="item1" />
                }
            </Rows>
            <Items>
                <DxGridLayoutItem Area="item1">
                    <Template>
                        @if (Model != null)
                        {
                            <DxTabs CssClass="card tabs">
                                <DxTabPage Text="Alt Kurumlar">
                                    <TenderSubComponent TenderId=@Id.Value/>
                                </DxTabPage>
                            </DxTabs>
                        }
                    </Template>
                </DxGridLayoutItem>
            </Items>
        </DxGridLayout>
    </div>

</div>
<DxPopup @bind-Visible="CustomerPopupVisible" HeaderText="Kamu Ýdare Unvaný Seçimi" Width="800px" Height="600px" Scrollable="true">
    <BodyTemplate>
        <DxGrid Data="@CustomerDataSource" ShowFilterRow="true" PageSize="12" SelectionMode="GridSelectionMode.Single" SelectedDataItemChanged="@OnCustomerSelected" VirtualScrollingEnabled="true" KeyFieldName="Code">
            <Columns>
                <DxGridSelectionColumn Width="100px" />
                <DxGridDataColumn FieldName="Code" Caption="Hesap Kodu" Width="150px" />
                <DxGridDataColumn FieldName="Name" Caption="Hesap Adý" />
            </Columns>
        </DxGrid>
    </BodyTemplate>
</DxPopup>



@code {
    [Parameter] public int? Id { get; set; }
    List<string> IhaleTurleri = new List<string> { "Kamu", "Özel" };
    List<string> IhaleMetotlari = new List<string> { "Hizmet Alýmý", "Mal Alýmý" };
    List<string> ParaBirimleri = new List<string> { "TRY", "USD", "EUR" };
    string? SecilenTur;
    string? SecilenMetot;
    string? SecilenPara;

    private List<FirmModel> Firms { get; set; } = new();
    private List<GuaranteeModel> TemporaryGuarantees { get; set; } = new();
    private TenderModel? Model = new();
    private EditContext? EditContext;
    private bool IsSaving, IsSuccess;
    private bool CustomerPopupVisible { get; set; } = false;
    private bool ShowValidationMessages { get; set; } = false;
    private IEnumerable<UserModel>? Users { get; set; }
    private GridDevExtremeDataSource<TenderModel>? TenderDataSource;
    private GridDevExtremeDataSource<CustomerModel>? CustomerDataSource;
    private ValidationMessageStore? _validationMessageStore;
    private bool IsEditMode => Id is > 0;
    private bool IsEndDateReadOnly => !IsEditMode;
    private List<EnumItem<ServiceType>> ServiceTypes =
    Enum.GetValues<ServiceType>()
        .Select(x => new EnumItem<ServiceType>
        {
            Value = x,
            Text = x.GetDescription()
        })
        .ToList();
    private bool IsSmallScreen { get; set; }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = await ApiClientFactory.CreateAsync(HttpClientFactory.CreateClient("ApiClient"));
            string baseUrl = "https://localhost:7071/api";
            await LoadUsersAsync();
            await LoadTemporaryGuaranteesAsync();
            await LoadFirmsAsync();
            if (Id.HasValue && Id.Value > 0)
            {
                var httpClient = HttpClientFactory.CreateClient("ApiClient");
                var api_client = await ApiClientFactory.CreateAsync(httpClient);
                var result = await api_client.GetFromJsonAsync<TenderModel>($"api/tenders/{Id.Value}");

                if (result != null)
                {
                    Model = result;
                    SecilenMetot = Model.TenderMethod;
                    SecilenTur = Model.TenderType;
                    SecilenPara = Model.Currency;
                    EditContext = new EditContext(Model);
                    _validationMessageStore = new ValidationMessageStore(EditContext);
                }
                else
                {
                    throw new Exception("Servis Talebi bulunamadý");
                }
            }
            else
            {
                Model = new TenderModel { };
            }

            EditContext = new EditContext(Model);
            _validationMessageStore = new ValidationMessageStore(EditContext);
            CustomerDataSource = new GridDevExtremeDataSource<CustomerModel>(client, NavigationManager.ToAbsoluteUri($"{baseUrl}/netsis/customers/pagedList"));
            TenderDataSource = new GridDevExtremeDataSource<TenderModel>(client, NavigationManager.ToAbsoluteUri($"{baseUrl}/tenders/"));
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(new ToastOptions()
            {
                ProviderName = "Overview",
                ThemeMode = ToastThemeMode.Light,
                RenderStyle = ToastRenderStyle.Warning,
                Title = "Veriler Yüklenirken bir hata oluþtu",
                Text = $"{ex.Message}"
            }, RenderToastButton(true));
        }
    }



    private RenderFragment RenderToastButton(bool isError)
    {
        return @<div class="d-flex gap-2">
            <DxButton Click="@(isError? OnPopupError:OnPopupOk)" RenderStyle="@(isError? ButtonRenderStyle.Danger: ButtonRenderStyle.Success)">Kapat</DxButton>
        </div>;
    }

    private async Task SaveFromOutside()
    {
        if (IsSaving || EditContext == null) return;

        ShowValidationMessages = true;

        var isDataAnnotationValid = EditContext.Validate();
        var isBusinessLogicValid = IsSaveButtonEnabledForValidation();

        if (isDataAnnotationValid && isBusinessLogicValid)
        {
            await HandleValidSubmit();
        }
        else
        {
            StateHasChanged();
        }
    }

    private bool IsSaveButtonEnabledForValidation()
    {
        if (Model == null || EditContext == null || _validationMessageStore == null)
            return false;

        _validationMessageStore.Clear();
        bool isValid = true;

        void AddError(string fieldName, string message)
        {
            _validationMessageStore.Add(EditContext.Field(fieldName), message);
            isValid = false;
        }


        if (Model.FirmId <= 0)
            AddError(nameof(Model.FirmId), "Firma seçilmesi zorunludur.");

        if (string.IsNullOrWhiteSpace(Model.TenderCode))
            AddError(nameof(Model.TenderCode), "Ýhale kodu zorunludur.");
        if (string.IsNullOrWhiteSpace(Model.TenderName))
            AddError(nameof(Model.TenderName), "Ýhale adý zorunludur.");

        if (string.IsNullOrWhiteSpace(Model.PublicAuthorityCode))
            AddError(nameof(Model.PublicAuthorityCode), "Cari kodu zorunludur.");
        if (SecilenTur == null || (SecilenTur is string s1 && string.IsNullOrWhiteSpace(s1)))
            AddError(nameof(SecilenTur), "Ýhale türü seçilmelidir.");
        if (SecilenMetot == null || (SecilenMetot is string s2 && string.IsNullOrWhiteSpace(s2)))
            AddError(nameof(SecilenMetot), "Ýhale metodu seçilmelidir.");

        if (Model.TenderStartDate == DateTime.MinValue)
            AddError(nameof(Model.TenderStartDate), "Ýhale baþlangýç tarihi zorunludur.");
        if (Model.TenderEndDate == DateTime.MinValue)
            AddError(nameof(Model.TenderEndDate), "Ýhale bitiþ tarihi zorunludur.");

        if (Model.TenderStartDate != DateTime.MinValue &&
            Model.TenderEndDate != DateTime.MinValue &&
            Model.TenderEndDate.Date < Model.TenderStartDate.Date)
        {
            AddError(nameof(Model.TenderEndDate), "Ýhale bitiþ tarihi baþlangýç tarihinden küçük olamaz.");
        }

        if (Model.TenderDueDate <= 0)
            AddError(nameof(Model.TenderDueDate), "Ýhale ödeme vadesi (gün) zorunludur.");


        if (Model.TenderQuantity <= 0)
            AddError(nameof(Model.TenderQuantity), "Ýhale miktarý 0'dan büyük olmalýdýr.");

        if (Model.TenderAmount <= 0)
            AddError(nameof(Model.TenderAmount), "Ýhale toplam tutarý 0'dan büyük olmalýdýr.");

        if (Model.UnitPrice <= 0)
            AddError(nameof(Model.UnitPrice), "Birim fiyat 0'dan büyük olmalýdýr.");

        if (SecilenPara == null || (SecilenPara is string s3 && string.IsNullOrWhiteSpace(s3)))
            AddError(nameof(SecilenPara), "Para birimi seçilmelidir.");


        if (Model.AnnouncementDate == DateTime.MinValue)
            AddError(nameof(Model.AnnouncementDate), "Ýhale ilan tarihi zorunludur.");


        if (Model.AnnouncementDate != DateTime.MinValue &&
            Model.TenderStartDate != DateTime.MinValue &&
            Model.AnnouncementDate.Date > Model.TenderStartDate.Date)
        {
            AddError(nameof(Model.AnnouncementDate), "Ýlan tarihi ihale baþlangýç tarihinden sonra olamaz.");
        }

        EditContext.NotifyValidationStateChanged();
        return isValid;
    }

    private async Task HandleValidSubmit()
    {
        if (IsSaving) return;
        IsSaving = true;
        IsSuccess = false;

        try
        {
            var httpClient = HttpClientFactory.CreateClient("ApiClient");
            var client = await ApiClientFactory.CreateAsync(httpClient);
            HttpResponseMessage response;

            if (Model?.Id > 0)
            {
                response = await client.PutAsJsonAsync("api/tenders", Model);
            }
            else
            {
                Model.TenderMethod = SecilenMetot;
                Model.Currency = SecilenPara;
                Model.TenderType = SecilenTur;
                response = await client.PostAsJsonAsync("api/tenders", Model);
            }

            if (response.IsSuccessStatusCode)
            {
                IsSuccess = true;
                ToastService.ShowToast(new ToastOptions()
                {
                    Id = "toast",
                    ProviderName = "Overview",
                    ThemeMode = ToastThemeMode.Light,
                    RenderStyle = ToastRenderStyle.Success,
                    Title = "Baþarýlý",
                    Text = "Servis bilgileri baþarýlý bir þekilde kaydedildi."
                }, RenderToastButton(false));
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();

                ToastService.ShowToast(new ToastOptions()
                {
                    Id = "toast",
                    ProviderName = "Overview",
                    ThemeMode = ToastThemeMode.Light,
                    RenderStyle = ToastRenderStyle.Danger,
                    Title = "Hata",
                    Text = errorMsg
                }, RenderToastButton(true));
            }
        }
        catch (Exception)
        {

            IsSuccess = false;
        }
        finally
        {

            IsSaving = false;
        }
    }


    #region Customers
    private void OpenCustomerPopup()
    {
        CustomerPopupVisible = true;
    }
    private void OnCustomerSelected(object selectedItem)
    {
        if (selectedItem is CustomerModel selectedCustomer)
        {
            Model.PublicAuthorityCode = selectedCustomer.Code;
            Model.PublicAuthorityName = selectedCustomer.Name;

            NotifyFieldChanged(nameof(Model.PublicAuthorityCode));

            CustomerPopupVisible = false;
            StateHasChanged();
        }
    }

    private void OnCustomerCodeChanged(string newValue)
    {
        Model.PublicAuthorityCode = newValue;

        if (string.IsNullOrWhiteSpace(newValue))
        {
            Model.PublicAuthorityName = null;
        }

        NotifyFieldChanged(nameof(Model.PublicAuthorityCode));
    }

    private void NotifyFieldChanged(string fieldName)
    {
        if (EditContext != null && _validationMessageStore != null)
        {
            var fieldIdentifier = EditContext.Field(fieldName);
            _validationMessageStore.Clear(fieldIdentifier);
            EditContext.NotifyFieldChanged(fieldIdentifier);
        }
    }

    #endregion

    #region Users
    private async Task LoadUsersAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("ApiClient");
        var client = await ApiClientFactory.CreateAsync(httpClient);
        Users = await client.GetFromJsonAsync<List<UserModel>>("https://localhost:7071/api/users/list");
    }
    #endregion

    #region Firms
    private async Task LoadFirmsAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("ApiClient");
            var client = await ApiClientFactory.CreateAsync(httpClient);

            var result = await client.GetFromJsonAsync<List<FirmModel>>("api/firms/list");

            if (result != null)
            {
                Firms = result;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Firma yükleme hatasý: {ex.Message}");
        }
    }
    #endregion

    #region TemporaryGuarantees
    private async Task LoadTemporaryGuaranteesAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("ApiClient");
            var client = await ApiClientFactory.CreateAsync(httpClient);

            var result = await client.GetFromJsonAsync<List<GuaranteeModel>>("api/guarantees/temporaries");

            if (result != null)
            {
                TemporaryGuarantees = result;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Firma yükleme hatasý: {ex.Message}");
        }
    }
    #endregion

    private void OnPopupOk()
    {
        if (IsSuccess) NavigationManager.NavigateTo("/service/requests");
    }

    private void OnPopupError()
    {
    }

    private void NavigateBack() => NavigationManager.NavigateTo("/service/requests");
}