@inject NavigationManager NavigationManager
@inject IApiClientFactory ApiClientFactory
@inject IHttpClientFactory HttpClientFactory
@inject IToastNotificationService ToastService

<div style="position:relative">

    <DxLoadingPanel @bind-Visible="IsGridLoading" Text="İşlem yapılıyor..." />

    <DxGrid Data="TenderUnitDataSource"
            EditStart="OnEditStart"
            ShowSearchBox="true"
            SearchBoxNullText="Arama yapmak için metin girin…"
            style="height:100%;"
            DataItemDeleting="Grid_DataItemDeleting">
        <ToolbarTemplate>
            <DxToolbar>
                <Items>
                    <DxToolbarItem Text="Yeni Alt Kurum Ekle"
                                   Click="OnAddNewClick"
                                   Alignment="ToolbarItemAlignment.Right"
                                   Enabled="!IsReadOnly"
                                   RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                                   RenderStyle="ButtonRenderStyle.Light" />
                </Items>
            </DxToolbar>
        </ToolbarTemplate>
        <Columns>
            <DxGridDataColumn FieldName="UnitCode" Caption="Alt Kurum Kodu" />
            <DxGridDataColumn FieldName="UnitName" Caption="Alt Kurum Adı" />
            @if (!IsReadOnly)
            {

                <DxGridCommandColumn Width="6em" DeleteButtonVisible="true" EditButtonVisible="true" />
            }

        </Columns>
        <EmptyDataAreaTemplate>
            @if (IsReadOnly)
            {
                <p>İhale alt kurumu eklemek için önce ihale kaydedin.</p>
            }
            else
            {
                <p>Görüntülenecek herhangi bir alt kurum bulunamadı.</p>
            }
        </EmptyDataAreaTemplate>

    </DxGrid>
</div>

<DxPopup @bind-Visible="@PopupVisible"
         HeaderText="Alt Kurum Ekle"
         Width="800px">
    <BodyContentTemplate Context="popupContext">
        <DxLoadingPanel @bind-Visible="IsLoadingForPopup" Text="İşlem yapılıyor..." />

        @if (Model != null)
        {
            <DxFormLayout>

                <DxFormLayoutItem Caption="Alt Cari Kodu" ColSpanMd="12">
                    <DxTextBox Text="@Model.UnitCode"
                               TextChanged="@((string val) => OnCustomerCodeChanged(val))"
                               TextExpression="@(() => Model.UnitCode)"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput">
                        <Buttons>
                            <DxEditorButton IconCssClass="three-point-icon icon medium-icon"
                                            Tooltip="Alt Birim Seç"
                                            Click="OpenCustomerPopup" />
                        </Buttons>
                    </DxTextBox>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Alt Cari Adı" ColSpanMd="12">
                    <DxTextBox @bind-Text="Model.UnitName" BindValueMode="BindValueMode.OnInput" ReadOnly="true" />
                </DxFormLayoutItem>
            </DxFormLayout>

        }
        else
        {
            <p>Yükleniyor...</p>
        }

        <div class="popup-footer-container">
            <DxButton Text="Vazgeç"
                      Enabled="!IsLoadingForPopup"
                      Click="() => PopupVisible = false"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      CssClass="footer-action-btn" />

            <DxButton Text="Kaydet"
                      Click="HandleSave"
                      Enabled="!IsLoadingForPopup"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="footer-action-btn" />
        </div>
    </BodyContentTemplate>
</DxPopup>
<DxPopup @bind-Visible="CustomerPopupVisible" HeaderText="Alt Kurum Seçimi" Width="800px" Height="600px" Scrollable="true">
    <BodyTemplate>
        <DxGrid Data="@CustomerDataSource" ShowFilterRow="true" PageSize="12" SelectionMode="GridSelectionMode.Single" SelectedDataItemChanged="@OnCustomerSelected" VirtualScrollingEnabled="true" KeyFieldName="Code">
            <Columns>
                <DxGridSelectionColumn Width="100px" />
                <DxGridDataColumn FieldName="Code" Caption="Hesap Kodu" Width="150px" />
                <DxGridDataColumn FieldName="Name" Caption="Hesap Adı" />
            </Columns>
        </DxGrid>
    </BodyTemplate>
</DxPopup>


@code {
    [Parameter] public TenderModel? Tender { get; set; }
    private bool PopupVisible { get; set; } = false;
    private TenderAuthorityModel? Model = new();
    private GridDevExtremeDataSource<TenderUnitModel>? TenderUnitDataSource;
    private bool ProductPopupVisible { get; set; } = false;
    private bool IsLoadingForPopup { get; set; }
    private bool IsGridLoading { get; set; }
    private bool IsReadOnly => Tender == null || Tender.Id == 0;
    private bool CustomerPopupVisible { get; set; } = false;
    private GridDevExtremeDataSource<CustomerModel>? CustomerDataSource;


    private List<EnumItem<ServiceDetailType>> DetailTypes =
        Enum.GetValues<ServiceDetailType>()
            .Select(x => new EnumItem<ServiceDetailType>
            {
                Value = x,
                Text = x.GetDescription()
            })
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (Tender != null && Tender.Id > 0)
        {
            await LoadDataAsync();

        }
    }

    private async Task LoadDataAsync()
    {
        if (IsReadOnly) return;

        try
        {
            IsLoadingForPopup = true;
            var client = await ApiClientFactory.CreateAsync(HttpClientFactory.CreateClient("ApiClient"));
            string baseUrl = "https://localhost:7071/api";
            TenderUnitDataSource = new GridDevExtremeDataSource<TenderUnitModel>(client, NavigationManager.ToAbsoluteUri($"{baseUrl}/tenders/sub?tenderId={Tender!.Id}&authorityCode={Tender!.PublicAuthorityCode}"));
            CustomerDataSource = new GridDevExtremeDataSource<CustomerModel>(client, NavigationManager.ToAbsoluteUri($"{baseUrl}/netsis/customers/pagedList"));
        }
        catch (Exception ex)
        {
            ShowToast("Hata", ex.Message, ToastRenderStyle.Danger);
        }
        finally
        {
            IsLoadingForPopup = false;
        }
    }

    private void OnAddNewClick()
    {
        if (IsReadOnly) return;
        Model = new TenderAuthorityModel();
        PopupVisible = true;
    }

    private void OnEditStart(GridEditStartEventArgs e)
    {
        if (IsReadOnly)
        {
            e.Cancel = true;
            return;
        }

        e.Cancel = true;
        var dataItem = (TenderUnitModel)e.DataItem;

        Model = new TenderAuthorityModel
        {
            Id = dataItem.Id,
            ParentAuthorityCode = Tender.PublicAuthorityCode,
            ParentAuthorityName = Tender.PublicAuthorityName,
            TenderId = Tender.Id,
            UnitCode = dataItem.UnitCode,
            UnitName = dataItem.UnitName
        };

        PopupVisible = true;
    }

    private async Task HandleSave()
    {
        if (Model == null || IsLoadingForPopup || IsReadOnly) return;


        try
        {
            IsLoadingForPopup = true;
            var client = await ApiClientFactory.CreateAsync(HttpClientFactory.CreateClient("ApiClient"));
            string baseUrl = "https://localhost:7071/api/tender-authorities";

            Model.TenderId = Tender!.Id;
            Model.ParentAuthorityCode = Tender.PublicAuthorityCode;

            HttpResponseMessage response;
            if (Model.Id > 0)
            {
                response = await client.PutAsJsonAsync(baseUrl, Model);
            }
            else
            {
                response = await client.PostAsJsonAsync(baseUrl, Model);
            }

            if (response.IsSuccessStatusCode)
            {
                ShowToast("Başarılı", "Kayıt başarıyla tamamlandı", ToastRenderStyle.Success);
                PopupVisible = false;
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
            }
            else
            {
                ShowToast("Hata", await response.Content.ReadAsStringAsync(), ToastRenderStyle.Danger);
            }
        }
        catch (Exception ex)
        {
            ShowToast("Sistem Hatası", ex.Message, ToastRenderStyle.Danger);
        }
        finally
        {
            IsLoadingForPopup = false;
            StateHasChanged();
        }
    }

    async Task Grid_DataItemDeleting(GridDataItemDeletingEventArgs e)
    {
        if (IsReadOnly)
        {
            e.Cancel = true;
            return;
        }

        e.Cancel = true;
        var tenderUnit = (TenderUnitModel)e.DataItem;

        try
        {
            IsGridLoading = true;
            StateHasChanged();

            var httpClient = HttpClientFactory.CreateClient("ApiClient");
            var client = await ApiClientFactory.CreateAsync(httpClient);
            var response = await client.DeleteAsync($"api/tender-authorities/{tenderUnit.Id}");

            if (response.IsSuccessStatusCode)
            {
                ShowToast("Başarılı", "Kayıt başarıyla silindi", ToastRenderStyle.Success);
                await LoadDataAsync();
            }
            else
            {
                ShowToast("Hata", await response.Content.ReadAsStringAsync(), ToastRenderStyle.Danger);
            }
        }
        catch (Exception ex)
        {
            ShowToast("Sistem Hatası", ex.Message, ToastRenderStyle.Danger);
        }
        finally
        {
            IsGridLoading = false;
            StateHasChanged();
        }
    }

    #region Customers
    private void OpenCustomerPopup()
    {
        CustomerPopupVisible = true;
    }
    private void OnCustomerSelected(object selectedItem)
    {
        if (selectedItem is CustomerModel selectedCustomer)
        {
            Model?.UnitCode = selectedCustomer.Code;
            Model?.UnitName = selectedCustomer.Name;
            CustomerPopupVisible = false;
            StateHasChanged();
        }
    }
    private void OnCustomerCodeChanged(string newValue)
    {
        Model.UnitCode = newValue;

        if (string.IsNullOrWhiteSpace(newValue))
        {
            Model.UnitName = null;
        }
    }

    #endregion
    private void ShowToast(string title, string text, ToastRenderStyle style)
    {
        ToastService.ShowToast(new ToastOptions
        {
            Id = "toast",
            ProviderName = "Overview",
            ThemeMode = ToastThemeMode.Light,
            RenderStyle = style,
            Title = title,
            Text = text
        });
    }
}
