@inject NavigationManager NavigationManager
@inject IApiClientFactory ApiClientFactory
@inject IHttpClientFactory HttpClientFactory
@inject IToastNotificationService ToastService

<div style="position:relative">

    <DxLoadingPanel @bind-Visible="IsGridLoading" Text="Ýþlem yapýlýyor..." />

    <DxGrid Data="TenderReagentDataSource"
            EditStart="OnEditStart"
            ShowSearchBox="true"
            SearchBoxNullText="Arama yapmak için metin girin…"
            style="height:100%;"
            DataItemDeleting="Grid_DataItemDeleting">
        <ToolbarTemplate>
            <DxToolbar>
                <Items>
                    <DxToolbarItem Text="Yeni Reaktif Ekle"
                                   Click="OnAddNewClick"
                                   Alignment="ToolbarItemAlignment.Right"
                                   Enabled="!IsReadOnly"
                                   RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                                   RenderStyle="ButtonRenderStyle.Light" />
                </Items>
            </DxToolbar>
        </ToolbarTemplate>
        <Columns>
            <DxGridDataColumn FieldName="UnitCode" Caption="Kurum Kodu" />
            <DxGridDataColumn FieldName="UnitName" Caption="Kurum Adý" />
            <DxGridDataColumn FieldName="StockCode" Caption="Ürün Kodu" />
            <DxGridDataColumn FieldName="StockName" Caption="Ürün Adý" />
            <DxGridDataColumn FieldName="SutCode" Caption="Sut Kodu" />
            <DxGridDataColumn FieldName="TestName" Caption="Test Adý" />
            <DxGridDataColumn FieldName="Quantity" Caption="Miktar" />
            <DxGridDataColumn FieldName="TestCount" Caption="Test Sayýsý" />
            <DxGridDataColumn FieldName="SutPoint" Caption="Sut Puaný" DisplayFormat="n2" />
            <DxGridDataColumn FieldName="TotalSutPoint" Caption="Toplam Sut Puaný" DisplayFormat="n2" />
            <DxGridDataColumn FieldName="Currency" Caption="Para Birim" />
            <DxGridDataColumn FieldName="UnitPrice" Caption="Birim Fiyatý" DisplayFormat="n4" />
            <DxGridDataColumn FieldName="TotalAmount" Caption="Toplam Tutar" DisplayFormat="n4" />
            <DxGridDataColumn FieldName="Quantity" Caption="Miktar" DisplayFormat="n2" />
            <DxGridDataColumn FieldName="TotalAmount" Caption="Toplam Fiyat" DisplayFormat="n4" />
            <DxGridDataColumn FieldName="PurchasePrice" Caption="Satýn Alma Fiyatý" DisplayFormat="n4" />
            <DxGridDataColumn FieldName="TotalPurchaseAmount" Caption="Toplam Satýn Alma Fiyatý" DisplayFormat="n4" />
            <DxGridDataColumn Caption="Talep Tipi" FieldName="RequestType" Width="120px">
                <CellDisplayTemplate>
                    <span class="status-badge">
                        @(((TenderReagentModel)context.DataItem).RequestType.GetDescription())
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="Durumu" FieldName="MaterialRequestStatus" Width="120px">
                <CellDisplayTemplate>
                    <span class="status-badge">
                        @(((TenderReagentModel)context.DataItem).MaterialRequestStatus.GetDescription())
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="Öncelik" FieldName="Priority" Width="120px">
                <CellDisplayTemplate>
                    <span class="status-badge">
                        @(((TenderReagentModel)context.DataItem).Priority.GetDescription())
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            @if (!IsReadOnly)
            {

                <DxGridCommandColumn Width="6em" DeleteButtonVisible="true" EditButtonVisible="true" />
            }

        </Columns>
        <EmptyDataAreaTemplate>
            @if (IsReadOnly)
            {
                <p>Ýhale reaktifi eklemek için önce ihale kaydedin.</p>
            }
            else
            {
                <p>Görüntülenecek herhangi bir reaktif bulunamadý.</p>
            }
        </EmptyDataAreaTemplate>

    </DxGrid>
</div>

<DxPopup @bind-Visible="@PopupVisible"
         HeaderText="Reaktif Ekle"
         Width="800px">
    <BodyContentTemplate Context="popupContext">
        <DxLoadingPanel @bind-Visible="IsLoadingForPopup" Text="Ýþlem yapýlýyor..." />

        @if (ReagentModel != null)
        {
            <DxFormLayout>

                <DxFormLayoutItem Caption="Ürün Kodu" ColSpanMd="12">
                    <DxTextBox @bind-Text="ReagentModel.StockCode"
                               @bind-Text:after="OnProductChanged"
                               NullText="Ürün kodu giriniz"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto">
                        <Buttons>
                            <DxEditorButton IconCssClass="three-point-icon icon medium-icon"
                                            Click="OpenProductPopup" />
                        </Buttons>
                    </DxTextBox>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Ürün Adý" ColSpanMd="12">
                    <DxTextBox @bind-Text="ReagentModel.StockName"
                               ReadOnly="true"
                               NullText="Ürün seçiniz..."
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Miktar" ColSpanMd="12">
                    <DxSpinEdit @bind-Value="ReagentModel.Quantity"
                                @bind-Value:after="OnCalculationChanged"
                                MinValue="0"
                                DisplayFormat="N2" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Birim Fiyat (Satýþ)" ColSpanMd="12">
                    <DxSpinEdit @bind-Value="ReagentModel.UnitPrice"
                                @bind-Value:after="OnCalculationChanged"
                                DisplayFormat="N2"
                                MinValue="0" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Toplam Tutar (Satýþ)" ColSpanMd="12">
                    <DxSpinEdit Value="ReagentModel.TotalAmount"
                                ReadOnly="true"
                                DisplayFormat="N2"
                                CssClass="fw-bold" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Alýþ Fiyatý" ColSpanMd="12">
                    <DxSpinEdit @bind-Value="ReagentModel.PurchasePrice"
                                @bind-Value:after="OnCalculationChanged"
                                DisplayFormat="N2"
                                MinValue="0" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Toplam Alýþ Tutarý" ColSpanMd="12">
                    <DxSpinEdit Value="ReagentModel.TotalPurchaseAmount"
                                ReadOnly="true"
                                DisplayFormat="N2"
                                CssClass="fw-bold" />
                </DxFormLayoutItem>



                <DxFormLayoutItem Caption="SUT Kodu" ColSpanMd="12">
                    <DxTextBox @bind-Text="ReagentModel.SutCode"
                               NullText="SUT kodu giriniz"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Test Adý" ColSpanMd="12">
                    <DxTextBox @bind-Text="ReagentModel.TestName"
                               NullText="Test adý giriniz"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="SUT Puaný" ColSpanMd="12">
                    <DxSpinEdit @bind-Value="ReagentModel.SutPoint"
                                @bind-Value:after="OnCalculationChanged"
                                DisplayFormat="N2"
                                MinValue="0" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Toplam SUT Puaný" ColSpanMd="12">
                    <DxSpinEdit Value="ReagentModel.TotalSutPoint"
                                ReadOnly="true"
                                DisplayFormat="N2"
                                CssClass="fw-bold" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Test Sayýsý" ColSpanMd="12">
                    <DxSpinEdit Value="ReagentModel.TestCount"
                                ReadOnly="true"
                                DisplayFormat="N2" />
                </DxFormLayoutItem>


                <DxFormLayoutItem Caption="Para Birimi" ColSpanMd="12">
                    <DxComboBox Data="@ParaBirimleri"
                                @bind-Value="SecilenPara"
                                FilteringMode="DataGridFilteringMode.Contains"
                                NullText="Birim arayýn veya seçin..."
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Açýklama" ColSpanMd="12">
                    <DxMemo @bind-Text="ReagentModel.Description"
                            Rows="4" />
                </DxFormLayoutItem>

            </DxFormLayout>



        }
        else
        {
            <p>Yükleniyor...</p>
        }

        <div class="popup-footer-container">
            <DxButton Text="Vazgeç"
                      Enabled="!IsLoadingForPopup"
                      Click="() => PopupVisible = false"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      CssClass="footer-action-btn" />

            <DxButton Text="Kaydet"
                      Click="HandleSave"
                      Enabled="!IsLoadingForPopup"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="footer-action-btn" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="ProductPopupVisible" HeaderText="Ürün Seçimi" Width="800px" Height="600px" Scrollable="true">
    <BodyTemplate>
        <DxGrid Data="@ProductDataSource"
                ShowFilterRow="true"
                PageSize="12"
                SelectionMode="GridSelectionMode.Single"
                SelectedDataItemChanged="@OnProductSelected"
                VirtualScrollingEnabled="true"
                KeyFieldName="Code">
            <Columns>
                <DxGridSelectionColumn Width="100px" />
                <DxGridDataColumn FieldName="Code" Caption="Stok Kodu" Width="150px" />
                <DxGridDataColumn FieldName="Name" Caption="Stok Adý" />
            </Columns>
        </DxGrid>
    </BodyTemplate>
</DxPopup>
@code {
    [Parameter] public TenderModel? Tender { get; set; }
    private bool ProductPopupVisible { get; set; }
    private bool PopupVisible { get; set; } = false;
    private GridDevExtremeDataSource<TenderReagentModel>? TenderReagentDataSource { get; set; }
    private TenderReagentModel? ReagentModel { get; set; }
    private bool IsLoadingForPopup { get; set; }
    private bool IsGridLoading { get; set; }
    private bool IsReadOnly => Tender == null || Tender.Id == 0;
    private GridDevExtremeDataSource<ProductModel>? ProductDataSource;
    List<string> ParaBirimleri = new List<string> { "TRY", "USD", "EUR" };
    string? SecilenPara;
    protected override async Task OnParametersSetAsync()
    {
        if (Tender != null && Tender.Id > 0)
        {
            await LoadDataAsync();

        }
    }

    private async Task LoadDataAsync()
    {
        if (IsReadOnly) return;

        try
        {
            IsLoadingForPopup = true;
            var client = await ApiClientFactory.CreateAsync(HttpClientFactory.CreateClient("ApiClient"));
            string baseUrl = "https://localhost:7071/api";
            TenderReagentDataSource = new GridDevExtremeDataSource<TenderReagentModel>(client, NavigationManager.ToAbsoluteUri($"{baseUrl}/tender-reagent?tenderId={Tender.Id}"));
            ProductDataSource = new GridDevExtremeDataSource<ProductModel>(client, NavigationManager.ToAbsoluteUri($"{baseUrl}/netsis/products/pagedList"));
        }
        catch (Exception ex)
        {
            ShowToast("Hata", ex.Message, ToastRenderStyle.Danger);
        }
        finally
        {
            IsLoadingForPopup = false;
        }
    }

    private void OnAddNewClick()
    {
        if (IsReadOnly) return;
        ReagentModel = new TenderReagentModel();
        PopupVisible = true;
    }

    private void OnEditStart(GridEditStartEventArgs e)
    {
        if (IsReadOnly)
        {
            e.Cancel = true;
            return;
        }

        e.Cancel = true;
        var dataItem = (TenderReagentModel)e.DataItem;
        SecilenPara = dataItem.Currency;
        ReagentModel = new TenderReagentModel
        {
            Id = dataItem.Id,
            ParentAuthorityCode = Tender.PublicAuthorityCode,
            StockName = dataItem.StockName,
            StockCode = dataItem.StockCode,
            Quantity = dataItem.Quantity,
            PurchasePrice = dataItem.PurchasePrice,
            Description = dataItem.Description,
            TenderAuthorityId = Tender.TenderAuthorityId,
            TenderId = Tender.Id,
            UnitCode = dataItem.UnitCode,
            UnitName = dataItem.UnitName,
            UnitPrice = dataItem.UnitPrice,
            SutCode = dataItem.SutCode,
            SutPoint = dataItem.SutPoint,
            TestName = dataItem.TestName,
            
        };

        PopupVisible = true;
    }

    private async Task HandleSave()
    {
        if (ReagentModel == null || IsLoadingForPopup || IsReadOnly) return;


        try
        {
            IsLoadingForPopup = true;
            var client = await ApiClientFactory.CreateAsync(HttpClientFactory.CreateClient("ApiClient"));
            string baseUrl = "https://localhost:7071/api/tender-reagent";

            ReagentModel.TenderId = Tender!.Id;
            ReagentModel.ParentAuthorityCode = Tender.PublicAuthorityCode;
            ReagentModel.TenderAuthorityId = Tender.TenderAuthorityId;
            ReagentModel.Currency = SecilenPara;
            HttpResponseMessage response;
            if (ReagentModel.Id > 0)
            {
                response = await client.PutAsJsonAsync(baseUrl, ReagentModel);
            }
            else
            {
                response = await client.PostAsJsonAsync(baseUrl, ReagentModel);
            }

            if (response.IsSuccessStatusCode)
            {
                ShowToast("Baþarýlý", "Kayýt baþarýyla tamamlandý", ToastRenderStyle.Success);
                PopupVisible = false;
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
            }
            else
            {
                ShowToast("Hata", await response.Content.ReadAsStringAsync(), ToastRenderStyle.Danger);
            }
        }
        catch (Exception ex)
        {
            ShowToast("Sistem Hatasý", ex.Message, ToastRenderStyle.Danger);
        }
        finally
        {
            IsLoadingForPopup = false;
            StateHasChanged();
        }
    }
    private void OpenProductPopup() => ProductPopupVisible = true;

    private void OnProductSelected(object selectedItem)
    {
        if (selectedItem is ProductModel selectedProduct)
        {
            ReagentModel.StockCode = selectedProduct.Code;
            ReagentModel.StockName = selectedProduct.Name;
            ProductPopupVisible = false;
            StateHasChanged();
        }
    }
    private void OnProductChanged()
    {

        if (string.IsNullOrWhiteSpace(ReagentModel.StockCode))
        {
            ReagentModel.StockName = string.Empty;
        }
    }

    async Task Grid_DataItemDeleting(GridDataItemDeletingEventArgs e)
    {
        if (IsReadOnly)
        {
            e.Cancel = true;
            return;
        }

        e.Cancel = true;
        var tenderOpex = (TenderReagentModel)e.DataItem;

        try
        {
            IsGridLoading = true;
            StateHasChanged();

            var httpClient = HttpClientFactory.CreateClient("ApiClient");
            var client = await ApiClientFactory.CreateAsync(httpClient);
            var response = await client.DeleteAsync($"api/tender-reagent/{tenderOpex.Id}");

            if (response.IsSuccessStatusCode)
            {
                ShowToast("Baþarýlý", "Kayýt baþarýyla silindi", ToastRenderStyle.Success);
                await LoadDataAsync();
            }
            else
            {
                ShowToast("Hata", await response.Content.ReadAsStringAsync(), ToastRenderStyle.Danger);
            }
        }
        catch (Exception ex)
        {
            ShowToast("Sistem Hatasý", ex.Message, ToastRenderStyle.Danger);
        }
        finally
        {
            IsGridLoading = false;
            StateHasChanged();
        }
    }
    void OnCalculationChanged()
    {
        StateHasChanged();
    }
    private void ShowToast(string title, string text, ToastRenderStyle style)
    {
        ToastService.ShowToast(new ToastOptions
        {
            Id = "toast",
            ProviderName = "Overview",
            ThemeMode = ToastThemeMode.Light,
            RenderStyle = style,
            Title = title,
            Text = text
        });
    }
}
