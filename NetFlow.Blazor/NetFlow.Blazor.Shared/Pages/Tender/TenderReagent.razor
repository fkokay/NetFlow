@inject NavigationManager NavigationManager
@inject IApiClientFactory ApiClientFactory
@inject IHttpClientFactory HttpClientFactory


<DxGrid Data="ReaktifDataSource" ShowSearchBox="true" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" SearchBoxNullText="Arama yapmak için metin girin…" style="height:100%;">
    <Columns>
        <DxGridDataColumn FieldName="UnitCode" Caption="Alt Kurum Kodu" />
        <DxGridDataColumn FieldName="UnitName" Caption="Alt Kurum Adý" />
        <DxGridDataColumn FieldName="StockCode" Caption="Stok Kodu" />
        <DxGridDataColumn FieldName="StockName" Caption="Stok Adý" />
        <DxGridDataColumn FieldName="TestName" Caption="Test Adý" />
        <DxGridDataColumn FieldName="TestCount" Caption="Test Sayýsý" />
        <DxGridDataColumn FieldName="UnitPrice" Caption="Birim Fiyat" DisplayFormat="n2" />
        <DxGridDataColumn FieldName="Currency" Caption="Para Birimi" />
        <DxGridDataColumn FieldName="MaterialRequestNo" Caption="Talep No">
            <CellDisplayTemplate>
                @if (((TenderReagentModel)context.DataItem).MaterialRequestId.HasValue)
                {
                    <a href="@NavigationManager.ToAbsoluteUri($"/material-request/details/{((TenderReagentModel)context.DataItem).MaterialRequestId}")">
                        @(((TenderReagentModel)context.DataItem).MaterialRequestNo)
                    </a>
                }
                else
                {
                    <span>-</span>
                }
            </CellDisplayTemplate>

        </DxGridDataColumn>
        <DxGridDataColumn Caption="Talep Durumu" FieldName="MaterialRequestStatus" Width="120px">
            <CellDisplayTemplate>
                <span class="status-badge">
                    @(((TenderReagentModel)context.DataItem).MaterialRequestStatus.GetDescription())
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="Ýþlemler" Width="100px" MinWidth="100">
            <CellDisplayTemplate>
                @if (!((TenderReagentModel)context.DataItem).MaterialRequestId.HasValue && !((TenderReagentModel)context.DataItem).MaterialRequestItemId.HasValue)
                {
                    <div @onclick:stopPropagation="true">
                        <DxButton Text="Talep Oluþtur"
                                  RenderStyle="ButtonRenderStyle.Info"
                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                  Size="SizeMode.Small"
                                  Click="() => OpenMaterialRequestPopup((TenderReagentModel)context.DataItem)" />
                    </div>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</DxGrid>


@if (IsReaktifMaterialRequestPopupVisible && SelectedTenderReagent != null)
{

    <ReagentMaterialRequestComponent @bind-IsPopupVisible="@IsReaktifMaterialRequestPopupVisible"
                                  Tender="@Tender"
                                  TenderReagent="@SelectedTenderReagent">
    </ReagentMaterialRequestComponent>
}


@code {
    private GridDevExtremeDataSource<TenderReagentModel>? ReaktifDataSource { get; set; }

    [Parameter]
    public required TenderModel Tender { get; set; }
    private TenderReagentModel? SelectedTenderReagent { get; set; }
    private bool _isReaktifMaterialRequestPopupVisible;
    private bool IsReaktifMaterialRequestPopupVisible
    {
        get => _isReaktifMaterialRequestPopupVisible;
        set
        {
            _isReaktifMaterialRequestPopupVisible = value;
            if (!value)
            {
                SelectedTenderReagent = null;
            }
        }
    }
    protected override async Task OnInitializedAsync()
    {
        var client = await ApiClientFactory.CreateAsync(HttpClientFactory.CreateClient("ApiClient"));
        string baseUrl = "https://localhost:7071/api";
        ReaktifDataSource = new GridDevExtremeDataSource<TenderReagentModel>(client, NavigationManager.ToAbsoluteUri($"{baseUrl}/tender-reagent?tenderId={Tender.Id}"));
    }

    private void OpenMaterialRequestPopup(TenderReagentModel model)
    {
        SelectedTenderReagent = model;
        IsReaktifMaterialRequestPopupVisible = true;
    }
}

