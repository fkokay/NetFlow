@implements IDisposable
@inject NavigationManager NavigationManager
@inject IApiClientFactory ApiClientFactory
@inject IHttpClientFactory HttpClientFactory
@inject IToastNotificationService ToastService

<div class="content-root">
    <div class="card toolbar">
        <DxToolbar Title="@Title" ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">

            <DxToolbarItem Text="Yeni Servis Oluþtur"
                           Tooltip="Yeni Servis Ekle"
                           Alignment="ToolbarItemAlignment.Right"
                           Click="OnAddClick"
                           IconCssClass="add-icon icon medium-icon"
                           RenderStyleMode="ToolbarItemRenderStyleMode.Plain" />

            <DxToolbarItem Tooltip="Column Chooser" Alignment="ToolbarItemAlignment.Right" Click="OnColumnChooserItemClick" IconCssClass="column-chooser-icon icon medium-icon" />

            <DxToolbarItem Text="Dýþarý Aktar" Alignment="ToolbarItemAlignment.Right" IconCssClass="export-icon icon medium-icon">
                <Items>
                    <DxToolbarItem Text="Tüm verileri Excel'e aktar" Click="ExportAllDataToExcel" />
                    <DxToolbarItem Text="Seçili satýrlarý Excel'e aktar" Click="ExportSelectedRowsToExcel" />
                    <DxToolbarItem Text="Tüm verileri CSV'ye aktar" Click="ExportAllDataToCsv" />
                    <DxToolbarItem Text="Seçili satýrlarý CSV'ye aktar" Click="ExportSelectedRowsDataToCsv" />
                    <DxToolbarItem Text="Tüm verileri PDF'e aktar" Click="ExportAllDataToPdf" />
                    <DxToolbarItem Text="Seçili satýrlarý PDF'e aktar" Click="ExportSelectedRowsDataToPdf" />
                </Items>
            </DxToolbarItem>

            <DxToolbarItem Alignment="ToolbarItemAlignment.Right" CssClass="search-textbox-item" Tooltip="Search">
                <Template Context="SearchContext">
                    <div class="custom-item">
                        <DxSearchBox CssClass="search-textbox"
                                     NullText="Ara"
                                     BindValueMode="BindValueMode.OnInput"
                                     ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                     @bind-Text=SearchText />
                    </div>
                </Template>
            </DxToolbarItem>

            <DxToolbarItem Tooltip="Refresh" Click="LoadGridDataAsync" BeginGroup="true" Alignment="ToolbarItemAlignment.Right" IconCssClass="refresh-icon icon medium-icon" />
        </DxToolbar>
    </div>

    <div class="Service-list-root h-100">
        <div class="h-100">
            <DxGrid @ref="Grid"
                    Data="Data"
                    KeyFieldName="Id"
                    CssClass="Service-list"
                    Style="height:100%;"
                    SearchText="@SearchText"
                    SkeletonRowsEnabled="true"
                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                    TextWrapEnabled="false"
                    FocusedRowEnabled="false"
                    ShowAllRows="true"
                    VirtualScrollingEnabled="true"
                    RowClick="@OnRowClick"
                    HighlightRowOnHover="true"
                    EditStart="OnEditStart">

                <Columns>

                    <!-- Seçim -->
                    <DxGridSelectionColumn Width="60px" />

                    <!-- Gizli Alanlar -->
                    <DxGridDataColumn FieldName="Id" Visible="false" />
                    <DxGridDataColumn FieldName="CustomerId" Visible="false" />
                    <DxGridDataColumn FieldName="ProductId" Visible="false" />
                    <DxGridDataColumn FieldName="AssignedPersonnelId" Visible="false" />

                    <!-- Servis / Ýþ Emri No -->
                    <DxGridDataColumn Caption="Servis No"
                                      FieldName="ServiceFormNo"
                                      Width="130px">
                        <CellDisplayTemplate>
                            @{
                                var service = (ServiceFormModel)context.DataItem;
                            }
                            <a href="javascript:void(0);"
                               style="font-weight:600; color:#0d6efd; text-decoration:none;"
                               @onclick:stopPropagation
                               @onclick="() => GoToDetails(service)">
                                @context.Value
                            </a>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <!-- Ýhale -->
                    <DxGridDataColumn Caption="Ýhale Kodu"
                                      FieldName="TenderCode"
                                      MinWidth="180" />
                    <DxGridDataColumn Caption="Ýhale Adý"
                                      FieldName="TenderName"
                                      MinWidth="180" />
                    <!-- Müþteri -->
                    <DxGridDataColumn Caption="Müþteri"
                                      FieldName="CustomerName"
                                      MinWidth="180" />

                    <DxGridDataColumn Caption="Alt Birim"
                                      FieldName="SubCustomerName"
                                      MinWidth="180" />

                    <!-- Servis Türü -->
                    <DxGridDataColumn Caption="Servis Türü"
                                      FieldName="ServiceType"
                                      Width="140px">
                        <CellDisplayTemplate>
                            <span class="status-badge">
                                @(((ServiceFormModel)context.DataItem).ServiceType.GetDescription())
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <!-- Durum -->
                    <DxGridDataColumn Caption="Durum"
                                      FieldName="ServiceStatus"
                                      Width="140px">
                        <CellDisplayTemplate>
                            <span class="status-badge">
                                @(((ServiceFormModel)context.DataItem).ServiceStatus.GetDescription())
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <!-- Açýklamalar (Ýþ Emrinde GÝZLÝ) -->
                    <DxGridDataColumn Caption="Problem Açýklamasý"
                                      FieldName="ProblemDescription"
                                      MinWidth="250"
                                      Visible="@(!IsWorkOrderPage)" />

                    <DxGridDataColumn Caption="Servis Açýklamasý"
                                      FieldName="ServiceDescription"
                                      Visible="false" />

                    <!-- Sorumlu Personel -->
                    <DxGridDataColumn Caption="Sorumlu Personel"
                                      FieldName="AssignedPersonnelName"
                                      MinWidth="180"
                                      Visible="@IsWorkOrderPage" />

                    <DxGridDataColumn Caption="Departman"
                                      FieldName="AssignedPersonnelDepartment"
                                      Width="150px"
                                      Visible="false" />

                    <DxGridDataColumn Caption="Ünvan"
                                      FieldName="AssignedPersonnelTitle"
                                      Width="150px"
                                      Visible="false" />
                    <!-- Teknisyen-->
                    <DxGridDataColumn Caption="Teknisyen"
                                      FieldName="TechnicianName"
                                      MinWidth="180"
                                      Visible="@IsWorkOrderPage" />
                    <!-- Tarihler -->
                    <DxGridDataColumn Caption="Atanma Tarihi"
                                      FieldName="AssignedAt"
                                      DisplayFormat="dd.MM.yyyy HH:mm"
                                      Width="160px"
                                      Visible="@(!IsWorkOrderPage)" />

                    <DxGridDataColumn Caption="Baþlangýç"
                                      FieldName="ServiceStartDate"
                                      DisplayFormat="dd.MM.yyyy"
                                      Width="130px"
                                      Visible="@IsWorkOrderPage" />

                    <DxGridDataColumn Caption="Bitiþ"
                                      FieldName="ServiceEndDate"
                                      DisplayFormat="dd.MM.yyyy"
                                      Width="130px"
                                      Visible="@IsWorkOrderPage" />

                    <!-- Maliyet -->
                    <DxGridDataColumn Caption="Ýþçilik"
                                      FieldName="LaborCost"
                                      DisplayFormat="N2"
                                      Width="120px"
                                      Visible="@(!IsWorkOrderPage)" />

                    <DxGridDataColumn Caption="Malzeme"
                                      FieldName="MaterialCost"
                                      DisplayFormat="N2"
                                      Width="120px"
                                      Visible="@(!IsWorkOrderPage)" />

                    <DxGridDataColumn Caption="Toplam Maliyet"
                                      FieldName="TotalCost"
                                      DisplayFormat="N2"
                                      Width="130px"
                                      Visible="@IsWorkOrderPage" />

                    <!-- Bayraklar -->
                    <DxGridDataColumn Caption="Yerinde"
                                      FieldName="IsOnSite"
                                      Width="90px"
                                      Visible="@(!IsWorkOrderPage)" />

                    <DxGridDataColumn Caption="Garanti"
                                      FieldName="IsWarranty"
                                      Width="90px"
                                      Visible="@IsWorkOrderPage" />

                    <DxGridDataColumn Caption="Teknisyen Atandý Mý"
                                      FieldName="IsTechnicianAssigned"
                                      Width="120px"
                                      Visible="@(!IsWorkOrderPage)" />

                    <!-- Varsayýlan Edit -->
                    <DxGridCommandColumn Width="6em"
                                         DeleteButtonVisible="false"
                                         EditButtonVisible="true" />

                    <!-- Teknisyen Ata -->
                    <DxGridDataColumn Caption="Ýþlemler"
                                      Width="150px"
                                      MinWidth="100"
                                      Visible="@(!IsWorkOrderPage && ShowAssignmentButton)">
                        <CellDisplayTemplate Context="cellContext">
                            @{
                                var row = (ServiceFormModel)cellContext.DataItem;
                            }

                            @if (!row.IsTechnicianAssigned)
                            {
                                <div @onclick:stopPropagation="true">
                                    <DxButton Text="Teknisyen Ata"
                                              RenderStyle="ButtonRenderStyle.Info"
                                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                                              Size="SizeMode.Small"
                                              Click="() => OpenTechnicianAssignmentPopup(row)" />
                                </div>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                </Columns>

            </DxGrid>

        </div>
    </div>
</div>

@if (AssignmentPopupVisible && SelectedService != null)
{
    <TechnicianAssignmentComponent ServiceForm="SelectedService" IsTechnicianAssignmentPopupVisible="true" OnCanceled="TechnicianAssignmentOnCanceled" OnSaved="TechnicianAssignmentOnSaved" />
}
@code {

    [Parameter] public required string Title { get; set; } = "Servis Talepleri";
    [Parameter] public required string Page { get; set; }
    [Parameter] public string? Type { get; set; }
    private bool IsWorkOrderPage =>
    string.Equals(Type, "work-orders", StringComparison.OrdinalIgnoreCase);
    [CascadingParameter(Name = "ParentSizeMode")]
    public SizeMode SizeMode { get; set; }
    [Parameter] public bool ShowAssignmentButton { get; set; } = false;
    private GridDevExtremeDataSource<ServiceFormModel> Data { get; set; } = null!;
    private IGrid? Grid { get; set; }
    private string? SearchText { get; set; }
    private CancellationTokenSource disposalTokenSource = new CancellationTokenSource();

    private bool AssignmentPopupVisible = false;
    private ServiceFormModel? SelectedService;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadGridDataAsync();
    }

    async Task LoadGridDataAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("ApiClient");
        var client = await ApiClientFactory.CreateAsync(httpClient);
        Data = new GridDevExtremeDataSource<ServiceFormModel>(client, NavigationManager.ToAbsoluteUri($"https://localhost:7071/api/service-forms/{Page}"));

        if (Grid != null)
            Grid.Reload();

        await InvokeAsync(StateHasChanged);
    }

    void OnColumnChooserItemClick(ToolbarItemClickEventArgs e) => Grid!.ShowColumnChooser();



    async Task OnRowClick(GridRowClickEventArgs args)
    {
        var service = (ServiceFormModel)Grid!.GetDataItem(args.VisibleIndex);
        if (service != null) NavigationManager.NavigateTo($"/service/details/{service.Id}");
    }


    void OnAddClick(ToolbarItemClickEventArgs e) => NavigationManager.NavigateTo("/service/createorupdate");


    Task ExportAllDataToExcel() => Grid!.ExportToXlsxAsync("Teminatlar");
    Task ExportSelectedRowsToExcel() => Grid!.ExportToXlsxAsync("Seçili Teminatlar", new GridXlExportOptions { ExportSelectedRowsOnly = true });
    Task ExportAllDataToCsv() => Grid!.ExportToCsvAsync("Teminatlar");
    Task ExportSelectedRowsDataToCsv() => Grid!.ExportToCsvAsync("Seçili Teminatlar", new GridCsvExportOptions { ExportSelectedRowsOnly = true });
    Task ExportAllDataToPdf() => Grid!.ExportToPdfAsync("Teminatlar");
    Task ExportSelectedRowsDataToPdf() => Grid!.ExportToPdfAsync("Seçili Teminatlar", new GridPdfExportOptions { ExportSelectedRowsOnly = true });


    private void OnEditStart(GridEditStartEventArgs e)
    {
        e.Cancel = true;
        var service = (ServiceFormModel)e.DataItem;
        NavigationManager.NavigateTo($"/service/createorupdate/{service.Id}");

    }
    private void GoToDetails(ServiceFormModel service)
    {
        if (service == null || service.Id <= 0)
            return;

        var url = IsWorkOrderPage
            ? $"/service/work-order-detail/{service.Id}"
            : $"/service/details/{service.Id}";

        NavigationManager.NavigateTo(url);
    }


    public void Dispose()
    {
        disposalTokenSource.Cancel();
        disposalTokenSource.Dispose();
    }
    void OpenTechnicianAssignmentPopup(ServiceFormModel item)
    {
        SelectedService = item;
        AssignmentPopupVisible = true;
    }

    private async Task TechnicianAssignmentOnSaved()
    {
        AssignmentPopupVisible = false;
        await LoadGridDataAsync();
    }

    private void TechnicianAssignmentOnCanceled()
    {
        AssignmentPopupVisible = false;
    }
}