@using System.Net.Http.Json
@inject IApiClientFactory ApiClientFactory
@inject IHttpClientFactory HttpClientFactory
@inject IToastNotificationService ToastService
@inject NavigationManager NavigationManager

<DxPopup @bind-Visible="@Visible"
         HeaderText="Talep Karþýla"
         Width="90%"
         ShowFooter="true">
    <BodyContentTemplate Context="fulfillmentContext">
        <div style="position: relative;">

            <DxLoadingPanel @bind-Visible="@IsLoading" Text="Yükleniyor..." />

            <DxGrid Data="FulfillmentItems" PageSize="10">
                <Columns>

                    <DxGridDataColumn FieldName="ItemCode" Caption="Kod" Width="120px" />
                    <DxGridDataColumn FieldName="ItemName" Caption="Adý" />

                    <DxGridDataColumn Caption="Talep Miktar" Width="150px">
                        <CellDisplayTemplate Context="c">
                            @{
                                var source = (MaterialRequestItemModel)c.DataItem;
                                var item = GetOrCreateItem(source);
                            }
                            <DxSpinEdit @bind-Value="item.RequestedQuantity"
                                        T="decimal"
                                        ReadOnly="true"
                                        Enabled="false"
                                        Mask="@NumericMask.RealNumber" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Tahmini Fiyat" Width="150px">
                        <CellDisplayTemplate Context="c">
                            @{
                                var source = (MaterialRequestItemModel)c.DataItem;
                            }
                            <DxSpinEdit Value="@source.Price"
                                        T="decimal"
                                        Mask="@NumericMask.RealNumber" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Para Birimi" Width="120px">
                        <CellDisplayTemplate Context="c">
                            @{
                                var source = (MaterialRequestItemModel)c.DataItem;
                                var item = GetOrCreateItem(source);
                            }
                            <DxComboBox Data="@ParaBirimleri"
                                        @bind-Value="item.Currency"
                                        Enabled="@(IsEditable && !IsLoading)" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Karþýlanan Miktar" Width="150px">
                        <CellDisplayTemplate Context="c">
                            @{
                                var source = (MaterialRequestItemModel)c.DataItem;
                                var item = GetOrCreateItem(source);
                            }
                            <DxSpinEdit @bind-Value="item.FulfilledQuantity"
                                        T="decimal"
                                        Mask="@NumericMask.RealNumber"
                                        Enabled="@(IsEditable && !IsLoading)" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <DxGridDataColumn Caption="Karþýlama Yöntemi" Width="200px">
                        <CellDisplayTemplate Context="c">
                            @{
                                var source = (MaterialRequestItemModel)c.DataItem;
                                var item = GetOrCreateItem(source);
                            }
                            <DxComboBox Data="@FulfillmentTypes"
                                        Value="item.FulfillmentType"
                                        ValueChanged="@((MaterialRequestItemFulfillmentType newValue) => OnFulfillmentTypeChanged(newValue, item))"
                                        TextFieldName="Text"
                                        ValueFieldName="Value"
                                        Enabled="@(IsEditable && !IsLoading)" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    

                    <DxGridDataColumn Caption="Cari Kodu" Width="200px">
                        <CellDisplayTemplate Context="c">
                            @{
                                var item = GetOrCreateItem((MaterialRequestItemModel)c.DataItem);
                            }

                            @if (item.FulfillmentType == MaterialRequestItemFulfillmentType.Purchase)
                            {
                                <DxTextBox Text="@item.PurchaseCustomerCode"
                                           ReadOnly="true">
                                    <Buttons>
                                        <DxEditorButton IconCssClass="three-point-icon icon medium-icon"
                                                        Tooltip="Cari Seç"
                                                        Click="@(() => OpenCustomerPopup(item))"
                                                        Enabled="@(IsEditable && !IsLoading)" />
                                    </Buttons>
                                </DxTextBox>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>


                    <DxGridDataColumn Caption="Cari Adý">
                        <CellDisplayTemplate Context="c">
                            @{
                                var item = GetOrCreateItem((MaterialRequestItemModel)c.DataItem);
                            }

                            @if (item.FulfillmentType == MaterialRequestItemFulfillmentType.Purchase)
                            {
                                <DxTextBox Text="@item.PurchaseCustomerName" ReadOnly="true" />
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>


                </Columns>
            </DxGrid>

        </div>
    </BodyContentTemplate>

    <FooterContentTemplate Context="fFooter">
        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                  Text="Seçimleri Gönder"
                  IconCssClass="dx-icon-check"
                  Click="OnConfirm"
                  Enabled="!IsLoading" />
        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                  Text="Vazgeç"
                  IconCssClass="dx-icon-close"
                  Click="Close"
                  Enabled="!IsLoading" />
    </FooterContentTemplate>
</DxPopup>


<DxPopup @bind-Visible="CustomerPopupVisible" HeaderText="Kamu Ýdare Unvaný Seçimi" Width="800px" Height="600px" Scrollable="true">
    <BodyTemplate>
        <DxGrid Data="@CustomerDataSource" ShowFilterRow="true" PageSize="12" SelectionMode="GridSelectionMode.Single" SelectedDataItemChanged="@OnCustomerSelected" VirtualScrollingEnabled="true" KeyFieldName="Code">
            <Columns>
                <DxGridSelectionColumn Width="100px" />
                <DxGridDataColumn FieldName="Code" Caption="Hesap Kodu" Width="150px" />
                <DxGridDataColumn FieldName="Name" Caption="Hesap Adý" />
            </Columns>
        </DxGrid>
    </BodyTemplate>
</DxPopup>
@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public int RequestId { get; set; }
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public EventCallback OnSuccess { get; set; }
    private bool CustomerPopupVisible { get; set; } = false;
    private bool IsLoading { get; set; }
    private GridDevExtremeDataSource<MaterialRequestItemModel>? FulfillmentItems;
    private FulfillmentRequestModel Model { get; set; } = new();
    List<string> ParaBirimleri = new List<string> { "TRY", "USD", "EUR" };
    private FulfillmentRequestItemModel? activeEditingItem;
    private GridDevExtremeDataSource<CustomerModel>? CustomerDataSource;
    private List<EnumItem<MaterialRequestItemFulfillmentType>> FulfillmentTypes =
        Enum.GetValues<MaterialRequestItemFulfillmentType>()
            .Select(x => new EnumItem<MaterialRequestItemFulfillmentType>
            {
                Value = x,
                Text = x.GetDescription()
            }).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && RequestId > 0 && !IsLoading)
            await LoadItems();
    }

    private async Task LoadItems()
    {
        try
        {
            IsLoading = true;

            Model = new FulfillmentRequestModel
            {
                Id = RequestId
            };

            var client = await ApiClientFactory.CreateAsync(
                HttpClientFactory.CreateClient("ApiClient"));

            var baseUrl = "https://localhost:7071/api";
            CustomerDataSource = new GridDevExtremeDataSource<CustomerModel>(client, NavigationManager.ToAbsoluteUri($"{baseUrl}/netsis/customers/pagedList"));
            FulfillmentItems = new GridDevExtremeDataSource<MaterialRequestItemModel>(
                client,
                NavigationManager.ToAbsoluteUri(
                    $"{baseUrl}/material-request-items?materialRequestId={RequestId}"
                )
            );
        }
        finally
        {
            IsLoading = false;
        }
    }


    private FulfillmentRequestItemModel GetOrCreateItem(MaterialRequestItemModel model)
    {
        var item = Model.Items.FirstOrDefault(x => x.ItemId == model.Id);
        if (item != null)
            return item;

        item = new FulfillmentRequestItemModel
        {
            ItemId = model.Id,
            RequestedQuantity = model.RequestedQuantity,
            FulfilledQuantity = model.FulfilledQuantity,
            FulfillmentType = model.FulfillmentType,
            Currency = model.Currency,
            PurchaseCustomerCode = model.PurchaseCustomerCode,
            PurchaseCustomerName = model.PurchaseCustomerName,
        };

        Model.Items.Add(item);
        return item;
    }

    private async Task OnConfirm()
    {
        if (IsLoading) return;

        try
        {
            IsLoading = true;

            var client = await ApiClientFactory.CreateAsync(
                HttpClientFactory.CreateClient("ApiClient"));

            var response = await client.PutAsJsonAsync(
                "api/material-requests/fulfill-items",
                Model);

            if (response.IsSuccessStatusCode)
            {
                ShowToast("Baþarýlý", "Ýþlem baþarýyla tamamlandý", ToastRenderStyle.Success);
                await OnSuccess.InvokeAsync();
                await Close();
            }
            else
            {
                ShowToast("Hata",
                    await response.Content.ReadAsStringAsync(),
                    ToastRenderStyle.Danger);
            }
        }
        catch (Exception ex)
        {
            ShowToast("Hata", ex.Message, ToastRenderStyle.Danger);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ShowToast(string title, string text, ToastRenderStyle style)
    {
        ToastService.ShowToast(new ToastOptions()
        {
            Id = "toast",
            ProviderName = "Overview",
            ThemeMode = ToastThemeMode.Light,
            RenderStyle = style,
            Title = title,
            Text = text,
        });
    }
    private void OnFulfillmentTypeChanged(MaterialRequestItemFulfillmentType newValue, FulfillmentRequestItemModel item)
    {
        
        item.FulfillmentType = newValue;
        if (newValue != MaterialRequestItemFulfillmentType.Purchase)
        {
            item.PurchaseCustomerCode = null;
            item.PurchaseCustomerName = null;
        }

        StateHasChanged();
    }

    #region Customers
    private void OpenCustomerPopup(FulfillmentRequestItemModel item)
    {
        activeEditingItem = item;
        CustomerPopupVisible = true;
    }
    private void OnCustomerSelected(object selectedItem)
    {
        if (selectedItem is CustomerModel selectedCustomer && activeEditingItem != null)
        {
            activeEditingItem.PurchaseCustomerCode = selectedCustomer.Code;
            activeEditingItem.PurchaseCustomerName = selectedCustomer.Name;

            CustomerPopupVisible = false;
            activeEditingItem = null;
            StateHasChanged();
        }
    }

    #endregion
    private async Task Close() =>
        await VisibleChanged.InvokeAsync(false);
}
